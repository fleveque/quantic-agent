# Copy to .env (gitignored) and fill in values. Loaded by direnv (.envrc: `dotenv`)
# or your shell; the agent itself doesn't read this file. Every setting also has a
# command-line flag (quantic-agent --help), which wins over the environment.

# --pr and --sync: the GitHub App the agent acts as (docs/target-machine.md §8b).
# The App ID is on the App's settings page; its private key goes in
# ~/.config/quantic-agent/github-app.pem, mode 600, or where QUANTIC_AGENT_GITHUB_KEY says.
QUANTIC_AGENT_GITHUB_APP_ID=
QUANTIC_AGENT_REPO=owner/quantic
# QUANTIC_AGENT_GITHUB_KEY=/home/you/.config/quantic-agent/github-app.pem  # absolute: ~ isn't expanded
# QUANTIC_AGENT_REPO_PATH=priv/insights

# Optional: the defaults are shown.
# OLLAMA_HOST=http://localhost:11434
# QUANTIC_MODEL=hf.co/unsloth/Qwen3.8-27B-GGUF:UD-IQ3_S
# QUANTIC_EMBED_MODEL=qwen3-embedding:0.6b
# QUANTIC_NUM_CTX=32768
# QUANTIC_MCP_URL=https://quantic.finance/mcp
# QUANTIC_AGENT_DB=/home/you/.local/state/quantic-agent/agent.db
# QUANTIC_AGENT_OUT=insights
